rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // El Superadmin se define por UID, y los administradores adicionales por la coleccion /admins/{uid}
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'fCFtVKY0EQMVA9MEbINtIaRBahm1' ||
        request.auth.uid == 'VTVqWuR9YoQoAInnbwiiGrXAFd43'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 20
        && username.matches('^[a-z0-9._]+$')
        && !username.matches('.*\\.\\..*');
    }

    function validUserProfileFields() {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'photoStoragePath', 'photoUpdatedAt',
        'followersCount', 'followingCount', 'createdAt', 'lastLogin',
        'username', 'usernameNormalized', 'usernameConfiguredAt',
        'gamification', 'xp', 'peakXP', 'level', 'leagueId', 'animalRankId',
        'rankingUpdatedAt'
      ]);
    }

    function validOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'email', 'displayName', 'photoURL', 'photoStoragePath', 'photoUpdatedAt',
        'createdAt', 'lastLogin', 'username', 'usernameNormalized', 'usernameConfiguredAt',
        'gamification', 'xp', 'peakXP', 'level', 'leagueId', 'animalRankId',
        'rankingUpdatedAt'
      ]);
    }

    function validInteractionCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'likesCount', 'commentsCount', 'latestComment'
      ]);
    }

    // Indice: un documento por username normalizado.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && username == username.lower()
        && validUsername(username)
        && (request.resource.data.uid == request.auth.uid || isAdmin())
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'updatedAt']);
      // Permite recuperar un indice cuyo dueno ya no tiene perfil.
      allow update: if isSignedIn()
        && username == username.lower()
        && validUsername(username)
        && (request.resource.data.uid == request.auth.uid || isAdmin())
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly(['uid', 'username', 'updatedAt'])
        && (isAdmin()
          || resource.data.uid == request.auth.uid
          || !exists(/databases/$(database)/documents/users/$(resource.data.uid)));
      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Perfil y fuente unica del ranking. leagueId/xp/peakXP se consultan aqui.
    match /users/{userId} {
      // El ranking y los perfiles publicos se pueden mostrar aun a invitados.
      allow read: if true;
      allow create: if isOwner(userId) && validUserProfileFields();
      allow create: if isAdmin() && validUserProfileFields();
      allow update: if isAdmin()
        || (isOwner(userId) && validOwnProfileUpdate())
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followersCount', 'followingCount']));
      allow delete: if isOwner(userId) || isAdmin();

      match /following/{followedUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == followedUserId || isAdmin());
      }

      match /followers/{followerUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == followerUserId || isAdmin());
      }

      // Historial privado del temporizador; se crea al confirmar la sincronizacion local.
      match /timer_sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Rutinas compartidas de comunidad.
    match /routines/{routineId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.creatorId)
        || (isSignedIn() && validInteractionCounterUpdate());
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.creatorId || isAdmin());

      match /likes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == get(/databases/$(database)/documents/routines/$(routineId)).data.creatorId
          || isAdmin()
        );
      }
    }

    // Feed historico de medallas. No se elimina al perder XP.
    match /achievements_posts/{achievementId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId)
        || (isSignedIn() && validInteractionCounterUpdate());
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());

      match /likes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == get(/databases/$(database)/documents/achievements_posts/$(achievementId)).data.userId
          || isAdmin()
        );
      }
    }

    // El cliente solo lee; el UID admin puede preparar estructura y publicar avisos de version.
    match /config/app_settings {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly([
        'minVersion', 'recommendedVersion',
        'profileUploadsEnabled', 'profileUploadsUpdatedAt', 'profileUploadsUpdatedBy', 'activeDatabase',
        'update_es', 'update_en'
      ]);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'minVersion', 'recommendedVersion',
        'profileUploadsEnabled', 'profileUploadsUpdatedAt', 'profileUploadsUpdatedBy', 'activeDatabase',
        'update_es', 'update_en'
      ]);
      allow delete: if false;
    }

    // Administradores y coaches del sistema
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId);
    }

    // Solicitudes de activacion de coaches
    match /coach_requests/{requestId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() && request.auth.uid == requestId;
    }

    // Rutinas asignadas por codigo con caducidad de 2 meses
    match /assigned_routines/{code} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesRedeemed', 'trainees'])
      );
      allow delete: if isAdmin() || (
        resource.data.isIndefinite != true &&
        'expiresAtMs' in resource.data &&
        resource.data.expiresAtMs != null &&
        resource.data.expiresAtMs < request.time.toMillis()
      );

      // Historial de sesiones y progreso de atletas que usan esta rutina
      match /workout_logs/{logId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.athleteUid || isAdmin());
      }
    }

    // Solicitudes temporales de recuperacion de contrasena (codigos 2 min)
    match /password_resets/{email} {
      allow read, write: if true;
    }
  }
}
